# ===============================
# ✅ Python Files to Ignore
# ===============================
# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environment (Poetry, venv, pipenv)
.venv/
env/
venv/
pipenv/
Pipfile.lock

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ===============================
# ✅ Logs & Debugging Files
# ===============================
*.log
*.out
*.err
debug.log

# ===============================
# ✅ Operating System Files
# ===============================
# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Linux
*~

# ===============================
# ✅ Dependency & Packaging Files
# ===============================
# If using Poetry
poetry.lock  

# If using pipenv
Pipfile.lock  

# If using Hatch
.hatch/

# If using pip-tools
requirements.txt
requirements-dev.txt

# Compiled distributions (Eggs, Wheels)
*.egg-info/
*.egg/
*.whl
dist/
build/

# ===============================
# ✅ IDE & Editor Specific Files
# ===============================
# VS Code settings
.vscode/

# JetBrains (PyCharm, IntelliJ)
.idea/

# Sublime Text
*.sublime-workspace

# Vim
*.swp
*.swo

# Eclipse
.project
.settings/
.metadata/

# ===============================
# ✅ Docker & Deployment Files
# ===============================
# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
k8s/
helm/
*.kubeconfig

# ===============================
# ✅ Testing & Coverage Files
# ===============================
# PyTest
.cache/
.tox/
.nox/

# Coverage reports
.coverage
coverage.xml
htmlcov/
nosetests.xml

# ===============================
# ✅ Miscellaneous
# ===============================
*.bak
*.tmp
*.pid
